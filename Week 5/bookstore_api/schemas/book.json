{
  "type": "object",
  "required": ["id"],
  "properties": {
    "id": { "type": "integer" },
    "title": { "type": "string", "minLength": 1 },
    "price": {
      "type": "number",
      "minimum": 1
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/author" }
    },
    "category": {
      "type": "object",
      "$ref": "#/$defs/category"
    }
  },
  "$defs": {
    "author": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" },
        "role": { "enum": ["lead", "co", "ed"] }
      }
    },
    "category": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" },
        "description": { "type": "string" }
      }
    }
  }
}
