{
  "info": {
    "name": "Books API — POST WITHOUT TITLE",
    "description": "Error case for POST missing title",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "books",
      "item": [
        {
          "name": "POST /books — create",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/books",
              "host": ["{{base_url}}"],
              "path": ["books"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"author\": \"Kleppmann\", \"year\": 2017}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 status code\", () => pm.response.to.have.status(400));",
                  "pm.test(\"validation error error code\", () => pm.expect(pm.response.json().code).to.eql(\"VALIDATION_ERROR\"));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "book_id",
      "value": ""
    }
  ]
}
